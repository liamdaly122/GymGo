    "seed:check": "tsx scripts/check-seed.ts",
    "icons:build": "tsx scripts/build-icons.ts",
    "test:e2e": "node e2e/smoke.mjs",
    "test:offline": "node e2e/offline.mjs",
    "templates:check": "tsx scripts/check-templates.ts",
    "test:plans": "node e2e/plans.mjs",
    "images:build": "tsx scripts/build-images.ts",
    "test:swap": "node e2e/swap.mjs",
    "test:gyms": "node e2e/gyms.mjs",
    "test:pro": "node e2e/pro.mjs",
    "test:block": "node e2e/block.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
