# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings -> API Keys. Steps in supabase/README.md.
# Only the public key ever belongs here: the publishable key (sb_publishable_...)
# or the legacy anon public key.
# The secret / service_role key must NEVER appear in this repo, in Vercel, or in the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
